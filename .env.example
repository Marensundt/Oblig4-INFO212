# Copy to .env (git-ignored) and fill in values locally. Never commit .env.
SECRET_KEY=
# Optional, only for AI image generation (A2). Leave empty to use the offline placeholder.
ANTHROPIC_API_KEY=
# Storage: neo4j (default) or sqlite
STORAGE=neo4j
# Neo4j. Put the password of your local server here, never in code.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Only for STORAGE=sqlite. Optional, defaults to instance/ektemat.sqlite
DATABASE=
