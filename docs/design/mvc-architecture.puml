@startuml mvc-architecture
' Ekte Mat Online — MVC architecture sketch (OB4 §3; 01-plan §3, §6). Updated 2026-10-29 to match the code (phase 10).
' Updated 2026-11-04 for Oblig 5: Neo4j is the default storage; factory.py chooses by STORAGE (docs/plans/11).
!pragma layout smetana
skinparam componentStyle rectangle

actor "Browser\n(customer / admin)" as Browser

package "app/views/templates (VIEW)" {
  [shop/*.html] as VShop
  [account/*.html] as VAccount
  [admin/*.html] as VAdmin
}

package "app/controllers (CONTROLLER)" {
  [shop blueprint\nC1 menu, C2 cart] as CShop
  [account blueprint\nlogin/register, C3–C5] as CAccount
  [admin blueprint\nA1–A4] as CAdmin
}

package "app/models (MODEL)" {
  [Domain classes\nUser, FoodItem, EventCategory, Order,\nOrderLine, GuestGroup, Question, Cart, CartLine, enums] as Domain
  [Domain rules\naccounts, catalogue, cart, ordering,\nquestions, images] as Rules
  [ImageService\n(offline placeholder / Claude SVG)] as Img
  [ImageStorage\n(picture files)] as Files
  package "repositories" {
    [Repository interfaces] as IRepo
    [factory.py\nbuild_repositories(config)\nSTORAGE = neo4j | sqlite] as Factory
    [neo4j/ implementations\n(default, Oblig 5)] as NeoRepo
    [sqlite/ implementations\n(STORAGE=sqlite)] as SqliteRepo
  }
}

database "Neo4j server\n(bolt://localhost:7687)" as Neo
database "instance/ektemat.sqlite\n(alternative)" as DB #line.dashed
folder "instance/uploads" as Uploads
cloud "AI image service\n(key from .env)" as AI #line.dashed

Browser --> CShop : HTTP
Browser --> CAccount : HTTP
Browser --> CAdmin : HTTP
CShop --> VShop : render
CAccount --> VAccount : render
CAdmin --> VAdmin : render
CShop --> Rules
CAccount --> Rules
CAdmin --> Rules
Rules --> Domain
Rules --> IRepo
CShop --> IRepo
CAccount --> IRepo
CAdmin --> IRepo
CAdmin --> Img
CAdmin --> Files
CShop --> Files : serve pictures
Files --> Uploads
Img ..> AI
IRepo <|.. NeoRepo
IRepo <|.. SqliteRepo
Factory ..> NeoRepo : creates (default)
Factory ..> SqliteRepo : creates
NeoRepo --> Neo : only place with Cypher\n(neo4j driver, parameterised)
SqliteRepo ..> DB : only place with SQL
NeoRepo --> Domain : returns domain objects
SqliteRepo --> Domain : returns domain objects
@enduml
